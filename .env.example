# Conexion a PostgreSQL. Solo la necesita la herramienta de mock:
# /img, /text y /fake funcionan sin base de datos.
# Con `docker compose up` esto se configura solo.
DATABASE_URL=postgresql://devkit:devkit@localhost:5432/devkit

# Puerto del servidor. La UI apunta aqui por defecto.
PORT=3200

# Ponlo en true solo si la API corre detras de un proxy de confianza
# (Railway, nginx). Determina si se hace caso a x-forwarded-for para el
# rate limit; en local debe quedarse en false.
TRUST_PROXY=false

# Requests por minuto y por IP.
RATE_LIMIT=60
